  "people": [
    {
      "id": "xu-jie",
      "name": "徐阶",
      "birth_year": 1503,
      "death_year": 1583,
      "summary": "1566年在任内阁首辅。1562年严嵩罢后居首，1568年七月致仕；1566年阁衔为建极殿大学士。首辅是阁臣班序与主持政务的地位，不能另造一个定员宰相官。",
      "source_ids": [
        "ms110",
        "ms213",
        "qingpu-xu"
      ]
    },
    {
      "id": "gao-gong",
      "name": "高拱",
      "birth_year": 1512,
      "death_year": 1578,
      "summary": "1566年初任礼部尚书，嘉靖四十五年三月兼文渊阁大学士入阁。1567年五月罢，1569年十二月复入并兼掌吏部事；1566年不可称首辅。",
      "source_ids": [
        "ms18",
        "ms110",
        "ms112",
        "ms213",
        "zhengzhou-gao"
      ]
    },
    {
      "id": "zhang-juzheng",
      "name": "张居正",
      "birth_year": 1525,
      "death_year": 1582,
      "summary": "1566年初为右春坊右谕德兼翰林院侍读，四月癸酉升翰林院侍读学士、掌院事；当年尚未入阁。世宗崩后迁礼部右侍郎，隆庆元年二月才入阁。《明史》本传写侍讲学士，本批以任命当时《明世宗实录》的侍读学士为准。",
      "source_ids": [
        "ms213",
        "ms110",
        "szsl557",
        "hubei-zhang"
      ]
    },
    {
      "id": "li-chunfang",
      "name": "李春芳",
      "birth_year": 1510,
      "death_year": 1584,
      "summary": "1566年在任阁臣，1565年四月入阁，至1568年徐阶归后才成为首辅。1566年三月所进吏部尚书为阁臣兼衔，不据此认定其掌吏部实务。",
      "source_ids": [
        "ms193",
        "ms110",
        "ms112",
        "huaian-li"
      ]
    },
    {
      "id": "guo-pu",
      "name": "郭朴",
      "birth_year": 1511,
      "death_year": 1593,
      "summary": "1566年初任吏部尚书，嘉靖四十五年三月兼武英殿大学士入阁，1567年九月致仕。入阁后保有吏部尚书衔，但1566年四月胡松已接掌吏部，不能将郭朴继续显示为该部实际主官。",
      "source_ids": [
        "ms213",
        "ms110",
        "ms112",
        "guo-bio"
      ]
    },
    {
      "id": "hu-zongxian",
      "name": "胡宗宪",
      "birth_year": 1512,
      "death_year": 1565,
      "summary": "1566年不在任：嘉靖四十一年（1562）十一月被逮后释令闲住；嘉靖四十四年（1565）再次入狱并死于狱中。不能把早年的浙直总督放入1566年现任名单。",
      "source_ids": [
        "ms205",
        "ms18",
        "xuancheng-hu"
      ]
    },
    {
      "id": "hai-rui",
      "name": "海瑞",
      "birth_year": null,
      "death_year": 1587,
      "summary": "1566年以户部云南清吏司主事上疏，随后系狱，当年不能概括为全年正常在署履职。获释及复职在世宗崩、穆宗立后；年号岁末跨公历1567，需按具体日期解释。早年兴国任职据县政府资料记为兴国知县；《明史》本传的兴国州判官记载另有出入，保留说明。",
      "source_ids": [
        "ms226",
        "ms18",
        "szsl555",
        "xingguo-hai"
      ]
    },
    {
      "id": "qi-jiguang",
      "name": "戚继光",
      "birth_year": 1528,
      "death_year": 1588,
      "summary": "1566年在福建总兵任内，从事东南军务；并非蓟镇总兵。北召记载有1567年应召和1568年北调两个时点，福建任期终点本批暂不硬定；1568年五月总理蓟、昌、保三镇练兵可确证。",
      "source_ids": [
        "ms212",
        "ms18",
        "yantai-qi",
        "miyun-qi"
      ]
    },
    {
      "id": "tan-lun",
      "name": "谭纶",
      "birth_year": 1520,
      "death_year": 1577,
      "summary": "1566年前段承接四川巡抚任职，年内转授兵部右侍郎、总督两广军务兼巡抚广西。《明史》仅给出先后顺序；临海机构资料记十月授官，本批未核到原始实录任命及抵任日，因此年内交接标作约略。1566年不能标为兵部尚书或蓟辽总督。",
      "source_ids": [
        "ms222",
        "taizhou-tan",
        "linhai-tan",
        "ms112"
      ]
    },
    {
      "id": "yan-song",
      "name": "严嵩",
      "birth_year": null,
      "death_year": null,
      "summary": "1566年不在任：嘉靖四十一年（1562）五月被勒令致仕，严世蕃伏诛后又削为民。死年在通行资料中有差异；本批不据《明史》又二年的相对叙事机械换算，留空待核。",
      "source_ids": [
        "ms308",
        "ms18",
        "ms110"
      ]
    },
    {
      "id": "yan-shifan",
      "name": "严世蕃",
      "birth_year": null,
      "death_year": 1565,
      "summary": "1566年已不在人世：嘉靖四十四年（1565）三月伏诛。其仕履含太常寺与工部名衔，但《明史》明载仍掌尚宝司事，不能据工部左侍郎衔就把他画成工部日常事务的实任主官；本批只收确知的尚宝司任职。",
      "source_ids": [
        "ms308",
        "ms18"
      ]
    }
